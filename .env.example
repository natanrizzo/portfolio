# Copie para .env e preencha. Use SEMPRE .env, nunca .env.local:
# o docker compose só lê .env, e o Next lê os dois dando precedência ao
# .env.local, então manter os dois faz os valores divergirem em silêncio.

# ---------- Banco ----------
# Porta publicada no host pelo docker-compose.override.yml.
# 5432 costuma estar ocupada por um Postgres instalado nativamente.
DB_PORT=15432

# Precisa apontar para a mesma porta de DB_PORT:
DATABASE_URL=postgres://portfolio:troque-esta-senha@localhost:15432/portfolio

# Usados pelo docker compose para criar o banco:
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=portfolio

# ---------- Sessão ----------
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
# Trocar este valor invalida todas as sessões abertas.
AUTH_SECRET=

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Cloudinary ----------
# O cloud name é público (vai para o bundle do navegador).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Estes dois são secretos e nunca saem do servidor.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# ---------- Seed do admin ----------
# Lidos apenas por `npm run db:seed`. Senha com no mínimo 12 caracteres.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ---------- Produção (VPS + Traefik) ----------
# Hostname puro que o Traefik vai rotear para este app — sem esquema e sem
# porta, porque o valor entra direto na regra Host() do Traefik.
SITE_DOMAIN=
# Sem TRAEFIK_NETWORK: o Traefik do VPS roda com network_mode: host e alcança
# o container pelo IP da rede `internal`, sem rede externa compartilhada.
# Entrypoint e cert resolver configurados no traefik do VPS.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Preenchidos automaticamente pelo GitHub Actions a cada deploy.
APP_IMAGE=
MIGRATOR_IMAGE=
